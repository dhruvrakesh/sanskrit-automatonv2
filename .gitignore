# DB backups (keep locally, don’t commit)
data/*_backup_*.db
*.db-journal
*.db-wal
*.db-shm

# Script backup / archives
scripts/scripts.zip

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.env
.env.local
.env.*.local

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Main DB (recreate locally; don’t commit)
data/context.db

# Runtime state files (generated by pipeline; never commit)
data/translation_progress.json
data/translation_config.json
data/jobs.jsonl

# Scratch / one-off scripts (already tracked, but don't track new ones)
tmp_*.py
tmp*.txt
AUDIT_BUGS_AND_CLEANUP.md

# Large export artefacts (regenerate from DB)
exports/*.html
exports/*.tsv
out/
